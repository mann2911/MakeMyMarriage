# Copy to .env.local for Google authentication. Never commit .env.local.
# The login UI and production build still work without credentials.
# Use this exact origin in the browser; production must use HTTPS.
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google OAuth client type: Web application (a Stitch API key cannot be used).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use MongoDB Atlas or a local replica set; authentication uses transactions.
MONGODB_URI=
MONGODB_DB=makemymarriage
